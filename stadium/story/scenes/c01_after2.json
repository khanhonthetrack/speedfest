			"lines": [
				{
					"id": "c01_after2_009",
					"speaker": "Gus",
					"text": "Somebody painted her black and put her in my auction. I didn't look close. Should've."
				},
				{
					"id": "c01_after2_010",
					"speaker": "Gus",
					"text": "Scrape the sill under the door. Go on."
				},
				{
					"id": "c01_after2_011",
					"speaker": "Kit",
					"text": "...It's white under here.",
					"gap": 1.2
				},
				{
					"id": "c01_after2_012",
					"speaker": "Gus",
					"text": "Chassis number's in the recovery file. Police copy. I kept it."
				},
				{
					"id": "c01_after2_013",
					"speaker": "Kit",
					"text": "It's the same number."
				},
				{
					"id": "c01_after2_014",
					"speaker": "Kit",
					"text": "Whose car was it?"
				},
				{
					"id": "c01_after2_015",
					"speaker": "Gus",
					"text": "Everybody in this town knows that car, kid. You just don't know it yet."
				},
				{
					"id": "c01_after2_016",
					"speaker": "Gus",
					"text": "File's in my cabin. Halloran's man wants the car. I'd say you've got about ten minutes to decide which of us you trust least."
				}
