			"lines": [
				{
					"id": "c01_after2_001",
					"speaker": "Gus",
					"text": "Tibor says you drive like you stole it."
				},
				{
					"id": "c01_after2_002",
					"speaker": "Kit",
					"text": "I bought it. From you. An hour ago."
				},
				{
					"id": "c01_after2_003",
					"speaker": "Gus",
					"text": "Yeah. You know what you bought?"
				},
				{
					"id": "c01_after2_004",
					"speaker": "Kit",
					"text": "A car."
				},
				{
					"id": "c01_after2_005",
					"speaker": "Gus",
					"text": "Eight years ago I winched that car out of the river. Under the Halloran Bridge."
				},
				{
					"id": "c01_after2_006",
					"speaker": "Gus",
					"text": "She was white then. Doors shut, windows up. Nobody inside."
				},
				{
					"id": "c01_after2_007",
					"speaker": "Kit",
					"text": "That's not funny."
				},
				{
					"id": "c01_after2_008",
					"speaker": "Gus",
					"text": "Nobody laughed then either."
				}
