extends Node
## Audio autoload: music (with crossfade), UI sounds and one-shot SFX.
## API fixed by docs/ARCHITECTURE.md "Audio". Buses: Settings.BUS_MUSIC / Settings.BUS_SFX.
## All sounds are generated by tools/audio/gen_all.py into res://audio/generated/.
##
## Small fixed player pools (no allocation per sound). Streams are loaded lazily and cached.
## Runs while the tree is paused, so the pause menu still clicks and the music keeps going.

const GEN := "res://audio/generated/"

## name -> [file, volume_db]
const UI := {
	"click": ["ui_click", -4.0],
	"hover": ["ui_hover", -8.0],
	"back": ["ui_back", -4.0],
	"confirm": ["ui_confirm", -3.0],
	"error": ["ui_error", -4.0],
}
const SFX := {
	"checkpoint": ["sfx_checkpoint", -3.0],
	"finish": ["sfx_finish", -2.0],
	"pb": ["sfx_pb", -1.0],
	"countdown": ["sfx_countdown", -5.0],
	"go": ["sfx_go", -4.0],
	"respawn": ["sfx_respawn", -4.0],
	"boost": ["sfx_boost", -3.0],
	"wall_hit": ["sfx_wall_hit", -3.0],
	"land": ["car_land", -3.0],
	"blowoff": ["car_blowoff", -5.0],
	"nitro": ["car_nitro_start", -5.0],
	"thunder": ["sfx_thunder", -2.0],
	"splash": ["sfx_splash", -4.0],
	"grind": ["car_squeal", -4.0],
}
## Looping ambience beds (weather).
const AMBIENCE := {
	"rain": ["amb_rain", -9.0],
}
## Dark-trap beats (owner, session 4), all generated by tools/audio/gen_trap.py. Races play
## "track_<id>" when it exists, else "race" (see race_music()).
const MUSIC := {
	"menu": ["music_menu", -5.0],
	"race": ["music_race", -7.0],
	"track_arena": ["music_arena", -7.0],
	"track_downtown": ["music_downtown", -7.0],
	"track_coast": ["music_coast", -7.0],
	"track_infield": ["music_arena", -7.0],
	"track_dunes": ["music_coast", -7.0],
	"track_rails": ["music_arena", -7.0],
}
const UI_POOL := 4
const SFX_POOL := 8
const MUSIC_FADE := 1.4
## The same sound is not retriggered faster than this (hover spam, wall scrapes).
const MIN_REPEAT := 0.045

var _cache: Dictionary = {}          # file -> AudioStream (or null if missing)
var _ui: Array[AudioStreamPlayer] = []
var _sfx: Array[AudioStreamPlayer] = []
var _ui_next := 0
var _sfx_next := 0
var _last_played: Dictionary = {}    # file -> time (s)
var _music: Array[AudioStreamPlayer] = []
var _music_active := 0               # index of the player that is (or will be) audible
var _music_name := ""
var _music_tween: Tween = null
var _gesture_seen := false
var _amb: AudioStreamPlayer
var _amb_name := ""
var _amb_tween: Tween = null
var _warned: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in UI_POOL:
		_ui.append(_make_player("Ui%d" % i, Settings.BUS_SFX))
	for i in SFX_POOL:
		_sfx.append(_make_player("Sfx%d" % i, Settings.BUS_SFX))
	for i in 2:
		_music.append(_make_player("Music%d" % i, Settings.BUS_MUSIC))
	_amb = _make_player("Ambience", Settings.BUS_SFX)
	_add_master_limiter()
	# Browsers only start audio after a user gesture. Godot resumes the AudioContext itself;
	# we restart the music once on the first gesture in case its start was swallowed.
	_gesture_seen = not OS.has_feature("web")
	set_process_input(not _gesture_seen)


## Engines, SFX and music can stack up; a hard limiter on Master keeps the sum from clipping.
## (Desktop/console only: the web build's sample playback bypasses bus effects.)
func _add_master_limiter() -> void:
	var mi := AudioServer.get_bus_index("Master")
	for i in AudioServer.get_bus_effect_count(mi):
		if AudioServer.get_bus_effect(mi, i) is AudioEffectHardLimiter:
			return
	var lim := AudioEffectHardLimiter.new()
	lim.ceiling_db = -0.5
	lim.release = 0.12
	AudioServer.add_bus_effect(mi, lim)


func _make_player(n: String, bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.name = n
	p.bus = bus
	add_child(p)
	return p


# --------------------------------------------------------------------------- public API

func play_ui(sound: String) -> void:
	var e: Array = UI.get(sound, [])
	if e.is_empty():
		_warn_once("Audio.play_ui: unknown sound '%s'" % sound)
		return
	_play_pooled(_ui, true, e[0], e[1], 1.0)


func play_sfx(sound: String, volume_db := 0.0, pitch := 1.0) -> void:
	var e: Array = SFX.get(sound, [])
	if e.is_empty():
		_warn_once("Audio.play_sfx: unknown sound '%s'" % sound)
		return
	_play_pooled(_sfx, false, e[0], float(e[1]) + volume_db, pitch)


func play_music(track: String) -> void:
	if track == "":
		stop_music()
		return
	var e: Array = MUSIC.get(track, [])
	if e.is_empty():
		_warn_once("Audio.play_music: unknown track '%s'" % track)
		return
	if track == _music_name and _music[_music_active].playing:
		return
	var stream := _stream(e[0], true)
	if stream == null:
		return
	_music_name = track
	var old := _music[_music_active]
	_music_active = 1 - _music_active
	var cur := _music[_music_active]
	cur.stream = stream
	cur.volume_db = -40.0
	cur.play()
	_fade_music(cur, float(e[1]), old)


## Music key for a race on `track_id`: its own beat when there is one, else the generic race beat.
static func race_music(track_id: String) -> String:
	var k := "track_" + track_id
	return k if MUSIC.has(k) else "race"


func stop_music() -> void:
	_music_name = ""
	_fade_music(null, 0.0, _music[_music_active])


## Looping ambience (e.g. "rain"), faded in over ~1 s; "" or stop_ambience() fades it out.
func play_ambience(bed: String, volume_db := 0.0) -> void:
	if bed == "":
		stop_ambience()
		return
	var e: Array = AMBIENCE.get(bed, [])
	if e.is_empty():
		_warn_once("Audio.play_ambience: unknown bed '%s'" % bed)
		return
	var stream := _stream(e[0], true)
	if stream == null:
		return
	if _amb_tween and _amb_tween.is_valid():
		_amb_tween.kill()
	var target := float(e[1]) + volume_db
	if _amb_name != bed or not _amb.playing:
		_amb.stream = stream
		_amb.volume_db = -40.0
		_amb.play()
	_amb_name = bed
	_amb_tween = create_tween()
	_amb_tween.tween_property(_amb, "volume_db", target, 1.0)


func stop_ambience() -> void:
	_amb_name = ""
	if _amb == null or not _amb.playing:
		return
	if _amb_tween and _amb_tween.is_valid():
		_amb_tween.kill()
	_amb_tween = create_tween()
	_amb_tween.tween_property(_amb, "volume_db", -50.0, 0.8)
	_amb_tween.tween_callback(_amb.stop)


func current_ambience() -> String:
	return _amb_name


## Name of the music that is playing ("" = none).
func current_music() -> String:
	return _music_name


func is_music_playing() -> bool:
	return _music_name != "" and _music[_music_active].playing


## Number of pooled players (for tests: pools never grow).
func get_player_count() -> int:
	return _ui.size() + _sfx.size() + _music.size() + 1


# --------------------------------------------------------------------------- internals

func _input(event: InputEvent) -> void:
	if _gesture_seen:
		return
	if event is InputEventKey or event is InputEventMouseButton or event is InputEventScreenTouch or event is InputEventJoypadButton:
		_gesture_seen = true
		set_process_input(false)
		if _music_name != "":
			_music[_music_active].play()
		if _amb_name != "" and not _amb.playing:
			_amb.play()


func _play_pooled(pool: Array[AudioStreamPlayer], is_ui: bool, file: String, volume_db: float, pitch: float) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(file, -10.0)) < MIN_REPEAT:
		return
	var stream := _stream(file, false)
	if stream == null:
		return
	_last_played[file] = now
	# prefer an idle player, otherwise steal round-robin
	var p: AudioStreamPlayer = null
	for q in pool:
		if not q.playing:
			p = q
			break
	if p == null:
		if is_ui:
			p = pool[_ui_next]
			_ui_next = (_ui_next + 1) % pool.size()
		else:
			p = pool[_sfx_next]
			_sfx_next = (_sfx_next + 1) % pool.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = clampf(pitch, 0.25, 4.0)
	p.play()


func _fade_music(fade_in: AudioStreamPlayer, target_db: float, fade_out: AudioStreamPlayer) -> void:
	if _music_tween and _music_tween.is_valid():
		_music_tween.kill()
	# any player that is neither fading in nor out stops now (rapid switching)
	for p in _music:
		if p != fade_in and p != fade_out and p.playing:
			p.stop()
	var fading_out := fade_out != null and fade_out != fade_in and fade_out.playing
	if fade_in == null and not fading_out:
		return
	_music_tween = create_tween()
	_music_tween.set_parallel(true)
	if fade_in:
		_music_tween.tween_property(fade_in, "volume_db", target_db, MUSIC_FADE * 0.6).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	if fading_out:
		_music_tween.tween_property(fade_out, "volume_db", -60.0, MUSIC_FADE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
		_music_tween.chain().tween_callback(fade_out.stop)


func _stream(file: String, loop: bool) -> AudioStream:
	if _cache.has(file):
		return _cache[file]
	var path := GEN + file + ".ogg"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
		if loop and s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
	else:
		_warn_once("Audio: missing " + path)
	_cache[file] = s
	return s


func _warn_once(msg: String) -> void:
	if _warned.has(msg):
		return
	_warned[msg] = true
	push_warning(msg)
