extends Node
## The adverts on the remake's screens and boards (autoload "Adverts"): a strip of famous Polish
## brands under parody names, our own designs (stadium/tools/texgen/brands.py), generated by
## stadium/tools/texgen/adverts.py into assets/tex/adverts.png (16 panels of 512 x 256 side by
## side). The surface shader's screen pattern shows them as on a football stadium's boards: a few
## ads along each board, changing together on rotation, and one ad on each billboard, changing
## from time to time (blocks/tm_surface.gdshader pattern 8, advert(); each screen's layout from
## its UVs: TmGeo.SCREENS; TmMaterials hands the strip to every screen material).

const PANEL := Vector2i(512, 256)
const COUNT := 16
const PATH := "res://assets/tex/adverts.png"

var _texture: Texture2D


func _ready() -> void:
	if ResourceLoader.exists(PATH):
		_texture = load(PATH)
	else:
		var blank := Image.create(PANEL.x * COUNT, PANEL.y, true, Image.FORMAT_RGBA8)
		blank.fill(Color(0.02, 0.04, 0.1))
		_texture = ImageTexture.create_from_image(blank)


## The adverts' texture (one ad per PANEL, side by side).
func texture() -> Texture2D:
	if _texture == null:
		_ready()
	return _texture
