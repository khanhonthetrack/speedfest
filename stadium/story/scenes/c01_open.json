			"lines": [
				{
					"id": "c01_open_004",
					"speaker": "Kit",
					"text": "Dee. It's black, it's wide, and it's going to go for way more than nine hundred."
				},
				{
					"id": "c01_open_005",
					"speaker": "Dee",
					"text": "Is it ugly? Ugly's cheap."
				},
				{
					"id": "c01_open_006",
					"speaker": "Kit",
					"text": "It's beautiful."
				},
				{
					"id": "c01_open_007",
					"speaker": "Dee",
					"text": "Then it's not nine hundred. Walk away, student."
				},
				{
					"id": "c01_open_008",
					"speaker": "Gus",
					"text": "Five hundred, anyone? Five. The backpack, five hundred. Six? Seven. Eight..."
				},
				{
					"id": "c01_open_009",
					"speaker": "Kit",
					"text": "He's going to eight. Nobody's..."
				},
				{
					"id": "c01_open_010",
					"speaker": "Coat",
					"text": "Two thousand."
				}
			],
