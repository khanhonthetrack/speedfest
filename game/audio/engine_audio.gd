class_name EngineAudio
extends Node3D
## Layered, rpm-driven car sound. API fixed by docs/ARCHITECTURE.md "Audio".
##
## Local car (is_local = true): non-positional AudioStreamPlayers on the SFX bus with the full
## set: idle/mid/high on-throttle layers crossfaded by rpm, an off-throttle layer, turbo whistle,
## blow-off, nitro, tire squeal, wind and landing thud.
## Remote cars: two AudioStreamPlayer3D layers (mid/high) with distance attenuation. Cheap.
##
## Every loop was rendered at a known base rpm (engine_layers.gd, generated by
## tools/audio/gen_all.py), so pitch_scale = rpm / base_rpm. set_params() only stores targets;
## _process() smooths them, so callers can feed raw per-frame values.

const Layers = preload("res://audio/engine_layers.gd")
const GEN := "res://audio/generated/"

## Overall level of the local engine and of remote engines (dB).
@export var local_engine_db := -4.5
@export var remote_engine_db := -2.0
## Remote engines: distance (m) at which they are at full level, and cut-off distance.
@export var remote_unit_size := 14.0
@export var remote_max_distance := 220.0

var car_id := ""
var is_local := true

# raw targets from set_params()
var _t_rpm := 0.0
var _t_throttle := 0.0
var _t_speed := 0.0
var _t_drift := 0.0
var _t_nitro := false
var _t_grounded := true
var _has_params := false

# smoothed state
var _rpm := 0.0
var _throttle := 0.0
var _speed := 0.0
var _drift := 0.0
var _nitro_g := 0.0
var _squeal_g := 0.0
var _boost := 0.0
var _air_time := 0.0
var _was_grounded := true
var _thr_peak := 0.0         # recent max throttle (for blow-off detection)
var _blowoff_cd := 0.0
var _limiter_t := 0.0

var _def: Dictionary = {}
var _players: Dictionary = {}   # key -> AudioStreamPlayer / AudioStreamPlayer3D
var _oneshots: Array[AudioStreamPlayer] = []
var _oneshot_next := 0
var _debug: Dictionary = {}


func setup(p_car_id: String, p_is_local: bool) -> void:
	car_id = p_car_id if Layers.CARS.has(p_car_id) else "kaze"
	is_local = p_is_local
	_def = Layers.CARS[car_id]
	_rpm = float(_def["idle_rpm"])
	_t_rpm = _rpm
	if is_inside_tree():
		_build()


func set_params(rpm_ratio: float, throttle: float, speed_kmh: float, drift: float, nitro: bool, grounded: bool) -> void:
	if _def.is_empty():
		return
	var idle: float = _def["idle_rpm"]
	var red: float = _def["redline"]
	_t_rpm = lerpf(idle, red, clampf(rpm_ratio, 0.0, 1.05))
	_t_throttle = clampf(throttle, 0.0, 1.0)
	_t_speed = absf(speed_kmh)
	_t_drift = clampf(drift, 0.0, 1.0)
	_t_nitro = nitro
	_t_grounded = grounded
	if not _has_params:
		_has_params = true
		_rpm = _t_rpm
		_throttle = _t_throttle
		_speed = _t_speed


## Debug/test view of the current mix: {key: {gain, pitch, playing}} plus rpm and boost.
func get_debug() -> Dictionary:
	return _debug


func get_player_count() -> int:
	return _players.size() + _oneshots.size()


func _ready() -> void:
	if not _def.is_empty() and _players.is_empty():
		_build()


func _build() -> void:
	for p in _players.values():
		(p as Node).queue_free()
	_players.clear()
	for o in _oneshots:
		o.queue_free()
	_oneshots.clear()
	var keys: Array[String] = []
	if is_local:
		keys = ["idle", "mid", "high", "off", "turbo", "nitro", "squeal", "wind"]
	else:
		keys = ["mid", "high"]
	for k in keys:
		var stream := _load_stream(_stream_name(k))
		if stream == null:
			continue
		var p: Node
		if is_local:
			var ap := AudioStreamPlayer.new()
			ap.bus = Settings.BUS_SFX
			ap.stream = stream
			ap.volume_db = -80.0
			p = ap
		else:
			var ap3 := AudioStreamPlayer3D.new()
			ap3.bus = Settings.BUS_SFX
			ap3.stream = stream
			ap3.volume_db = -80.0
			ap3.unit_size = remote_unit_size
			ap3.max_distance = remote_max_distance
			ap3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
			ap3.panning_strength = 0.8
			p = ap3
		p.name = "Snd_" + k
		add_child(p)
		_players[k] = p
		p.call("play")
		p.set("stream_paused", true)
	if is_local:
		for i in 3:
			var o := AudioStreamPlayer.new()
			o.name = "SndOneShot%d" % i
			o.bus = Settings.BUS_SFX
			add_child(o)
			_oneshots.append(o)


func _stream_name(key: String) -> String:
	match key:
		"idle", "mid", "high", "off":
			return "eng_%s_%s" % [car_id, key]
		_:
			return "car_" + key


static func _load_stream(stream_name: String) -> AudioStream:
	var path := GEN + stream_name + ".ogg"
	if not ResourceLoader.exists(path):
		push_warning("EngineAudio: missing " + path)
		return null
	var s := load(path) as AudioStream
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	return s


func _process(delta: float) -> void:
	if _players.is_empty() or not _has_params:
		return
	var dt := clampf(delta, 0.0, 0.1)
	# --- smoothing (exponential, frame-rate independent)
	_rpm = lerpf(_rpm, _t_rpm, 1.0 - exp(-dt * 14.0))
	_throttle = lerpf(_throttle, _t_throttle, 1.0 - exp(-dt * 12.0))
	_speed = lerpf(_speed, _t_speed, 1.0 - exp(-dt * 8.0))
	_drift = lerpf(_drift, _t_drift, 1.0 - exp(-dt * 10.0))

	var idle: float = _def["idle_rpm"]
	var red: float = _def["redline"]
	var bases: Dictionary = _def["layers"]
	var rn := clampf((_rpm - idle) / (red - idle), 0.0, 1.0)
	# off-throttle the engine gets quieter (more so at high rpm)
	var load_gain := lerpf(lerpf(0.95, 0.42, rn), 1.0, _throttle)
	# rev limiter stutter when bouncing off the redline on throttle
	var limiter := 1.0
	if _t_rpm >= red * 0.995 and _throttle > 0.5:
		_limiter_t += dt
		limiter = 0.55 if fmod(_limiter_t, 0.075) < 0.03 else 1.0
	else:
		_limiter_t = 0.0

	# --- on-throttle layers: equal-power crossfade idle -> mid -> high
	var i_b: float = bases["idle"]
	var m_b: float = bases["mid"]
	var h_b: float = bases["high"]
	var x1 := sqrt(i_b * m_b)
	var x2 := sqrt(m_b * h_b)
	var t1 := smoothstep(x1 * 0.8, x1 * 1.25, _rpm)
	var t2 := smoothstep(x2 * 0.82, x2 * 1.2, _rpm)
	var w_idle := cos(t1 * PI * 0.5)
	var w_mid := sin(t1 * PI * 0.5) * cos(t2 * PI * 0.5)
	var w_high := sin(t2 * PI * 0.5)
	var eng_db := local_engine_db if is_local else remote_engine_db
	var g := db_to_linear(eng_db) * load_gain * limiter
	if is_local:
		_mix("idle", w_idle * g, _rpm / i_b)
		_mix("mid", w_mid * g, _rpm / m_b)
		_mix("high", w_high * g, _rpm / h_b)
		var off_g := (1.0 - _throttle) * smoothstep(idle * 1.4, idle * 2.6, _rpm) * 0.85
		_mix("off", off_g * db_to_linear(eng_db), _rpm / float(bases["off"]))
		_update_extras(dt, rn)
	else:
		# remote: two layers; mid also covers idle (pitched down)
		var wm := cos(t2 * PI * 0.5)
		_mix("mid", wm * g, _rpm / m_b)
		_mix("high", w_high * g, _rpm / h_b)
	_debug["rpm"] = _rpm
	_debug["boost"] = _boost


func _update_extras(dt: float, rn: float) -> void:
	var turbo_amt: float = _def["turbo"]
	# --- turbo: boost builds with throttle * rpm, collapses on lift
	var want_boost := _throttle * smoothstep(0.25, 0.9, rn) if _t_throttle > 0.4 else 0.0
	var rate := 1.6 if want_boost > _boost else 7.0
	_boost = move_toward(_boost, want_boost, rate * dt)
	_mix("turbo", pow(_boost, 1.5) * turbo_amt * 0.22, 0.55 + 0.75 * _boost)
	# blow-off on a quick lift from high boost
	_blowoff_cd = maxf(0.0, _blowoff_cd - dt)
	_thr_peak = maxf(_t_throttle, _thr_peak - dt * 4.0)
	if _t_throttle < 0.25 and _thr_peak > 0.6 and _boost > 0.15 and _blowoff_cd <= 0.0 and turbo_amt > 0.2:
		var bo_boost := maxf(_boost, 0.4)
		_play_oneshot("car_blowoff", linear_to_db(clampf(bo_boost * turbo_amt, 0.05, 1.0)) - 4.0, randf_range(0.92, 1.08) * (0.85 if car_id == "brute" else 1.0))
		_blowoff_cd = 0.6
		_thr_peak = 0.0
	# --- nitro
	if _t_nitro and _nitro_g < 0.05:
		_play_oneshot("car_nitro_start", -5.0, randf_range(0.95, 1.05))
	_nitro_g = move_toward(_nitro_g, 1.0 if _t_nitro else 0.0, dt * (8.0 if _t_nitro else 3.0))
	_mix("nitro", _nitro_g * 0.5, 0.9 + clampf(_speed / 300.0, 0.0, 1.0) * 0.25)
	# --- tire squeal (only on the ground and moving)
	var sq := smoothstep(0.12, 0.6, _drift) * (1.0 if _t_grounded else 0.0) * clampf((_speed - 8.0) / 25.0, 0.0, 1.0)
	_squeal_g = move_toward(_squeal_g, sq, dt * (6.0 if sq > _squeal_g else 4.0))
	_mix("squeal", _squeal_g * 0.42, 0.88 + 0.22 * _drift + clampf(_speed / 400.0, 0.0, 0.15))
	# --- wind
	var sp := clampf(_speed / 300.0, 0.0, 1.2)
	_mix("wind", pow(sp, 1.6) * 0.45, 0.75 + 0.45 * sp)
	# --- landing thud
	if not _t_grounded:
		_air_time += dt
	elif not _was_grounded:
		if _air_time > 0.25:
			var v := clampf((_air_time - 0.25) / 1.2, 0.0, 1.0)
			_play_oneshot("car_land", lerpf(-10.0, 0.0, v), randf_range(0.9, 1.08))
		_air_time = 0.0
	_was_grounded = _t_grounded


func _mix(key: String, gain: float, pitch: float) -> void:
	var p: Node = _players.get(key)
	if p == null:
		return
	var playing := gain > 0.0015
	var paused: bool = p.get("stream_paused")
	if playing:
		p.set("volume_db", linear_to_db(gain))
		p.set("pitch_scale", clampf(pitch, 0.25, 3.5))
		if paused:
			p.set("stream_paused", false)
	elif not paused:
		p.set("stream_paused", true)
	_debug[key] = {"gain": gain, "pitch": pitch, "playing": playing}


func _play_oneshot(stream_name: String, volume_db: float, pitch: float) -> void:
	if _oneshots.is_empty():
		return
	var s := _load_stream_oneshot(stream_name)
	if s == null:
		return
	var o := _oneshots[_oneshot_next]
	_oneshot_next = (_oneshot_next + 1) % _oneshots.size()
	o.stream = s
	o.volume_db = volume_db
	o.pitch_scale = pitch
	o.play()
	_debug["last_oneshot"] = stream_name


static func _load_stream_oneshot(stream_name: String) -> AudioStream:
	var path := GEN + stream_name + ".ogg"
	if not ResourceLoader.exists(path):
		return null
	return load(path) as AudioStream
