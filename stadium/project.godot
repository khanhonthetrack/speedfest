; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpeedFest Stadium"
run/main_scene="res://ui/menu.tscn"
config/description="Stadium time-attack remake on SpeedFest's engine: TMNF-faithful car physics, recreated blocks and visuals."
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TestHooks="*res://autoload/test_hooks.gd"
Online="*res://net/tm_online.gd"
Music="*res://audio/tm_music.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="car"
3d_physics/layer_3="trigger"

[physics]

jolt_physics_3d/queries/enable_ray_cast_face_index=true
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=100
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
