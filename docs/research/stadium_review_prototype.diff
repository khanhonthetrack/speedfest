+## REVIEW PROTOTYPE (session 14): TMNF's sign board (GATE_SIGN's outline) built as a screen: a thin
+## dark bezel panel, a lit screen inset on its road side, and two struts down to the arch.
+func _sign_screen(geo: TmGeo, zc: float, mirror: bool) -> void:
+	var bot := Vector2(7.11, 8.17)
+	var top := Vector2(10.035, 11.4)
+	var d := (top - bot).normalized()
+	var n := Vector2(d.y, -d.x)          # the face towards the road below
+	var fx := func(v: Vector2) -> Vector2: return Vector2(32.0 - v.x, v.y) if mirror else v
+	for part: Array in [[-0.06, 0.06, 0.0, 2.25, "gate_shell"], [0.05, 0.075, 0.16, 2.08, "screen"]]:
+		var o0: float = part[0]
+		var o1: float = part[1]
+		var ins: float = part[2]
+		var hz: float = part[3]
+		var mat: String = part[4]
+		var sec := []
+		for v: Vector2 in [bot + d * ins + n * o0, top - d * ins + n * o0, top - d * ins + n * o1, bot + d * ins + n * o1]:
+			sec.append([fx.call(v), mat, TmGeo.NO_COLLISION])
+		geo.wall_sweep(sec, [Vector3(0, 0, zc - hz), Vector3(0, 0, zc + hz)], [Vector3(1, 0, 0), Vector3(1, 0, 0)],
+			true, mat, TmGeo.NO_COLLISION)
+	for dz: float in [-1.5, 1.5]:
+		var x0 := 6.98 if not mirror else 32.0 - 7.24
+		geo.box(Vector3(x0, 6.5, zc + dz - 0.08), Vector3(x0 + 0.26, 8.3, zc + dz + 0.08), "gate_shell", TmGeo.NO_COLLISION)
+
+
 ## The word a gate block shows: a start/finish line (MultiLap) ends our races, so it says FINISH.
 func _sign_kind() -> String:
 	return "finish" if _gate_kind == "lap" else _gate_kind
diff --git a/stadium/env/tm_stadium_env.gd b/stadium/env/tm_stadium_env.gd
