extends Node
## The adverts on the remake's screens and boards (autoload "Adverts"): a strip of famous Polish
## brands under parody names, our own designs (stadium/tools/texgen/brands.py), generated by
## stadium/tools/texgen/adverts.py into assets/tex/adverts.png (16 panels of 512 x 256 side by
## side) with adverts_fill.png (each ad's background per row: a board longer than the ad shows it
## centred and its background out to the ends). Each screen shows one ad at a time, fitted to its
## size, and they rotate: every board the same ad, all changing together; each billboard its own
## (blocks/tm_surface.gdshader pattern 8, advert(); a screen's layout from its UVs: TmGeo.SCREENS;
## TmMaterials hands both textures to every screen material).

const PANEL := Vector2i(512, 256)
const COUNT := 16
const PATH := "res://assets/tex/adverts.png"
const FILL_PATH := "res://assets/tex/adverts_fill.png"

var _texture: Texture2D
var _fill: Texture2D


func _ready() -> void:
	_texture = _load(PATH, Vector2i(PANEL.x * COUNT, PANEL.y))
	_fill = _load(FILL_PATH, Vector2i(COUNT, PANEL.y))


static func _load(path: String, size: Vector2i) -> Texture2D:
	if ResourceLoader.exists(path):
		return load(path)
	var blank := Image.create(size.x, size.y, false, Image.FORMAT_RGBA8)
	blank.fill(Color(0.02, 0.04, 0.1))
	return ImageTexture.create_from_image(blank)


## The adverts' texture (one ad per PANEL, side by side).
func texture() -> Texture2D:
	if _texture == null:
		_ready()
	return _texture


## Their fill: one column per ad, each row's background colour.
func fill_texture() -> Texture2D:
	if _fill == null:
		_ready()
	return _fill
