			"lines": [
				{
					"id": "c01_close_001",
					"speaker": "Dee",
					"text": "Kit. Kit! Open up."
				},
				{
					"id": "c01_close_002",
					"speaker": "Kit",
					"text": "What... what time is it?"
				},
				{
					"id": "c01_close_003",
					"speaker": "Dee",
					"text": "Gone six. You slept in it."
				},
				{
					"id": "c01_close_004",
					"speaker": "Kit",
					"text": "I wasn't sleeping. I was driving. The bridge."
				},
				{
					"id": "c01_close_005",
					"speaker": "Dee",
					"text": "You were drooling on my clean seats."
				},
				{
					"id": "c01_close_006",
					"speaker": "Kit",
					"text": "There was someone in the back."
				},
				{
					"id": "c01_close_007",
					"speaker": "Dee",
					"text": "There's a parcel shelf back there, and a wet patch. You need a new door seal, that's all."
				},
				{
					"id": "c01_close_008",
					"speaker": "Kit",
					"text": "I saw her in the mirror. She was soaking."
				},
				{
					"id": "c01_close_009",
					"speaker": "Dee",
					"text": "Old cars give you bad dreams. They've been places."
				},
				{
					"id": "c01_close_010",
					"speaker": "Dee",
					"text": "Huh. Nine pins.",
					"gap": 1.0
				},
				{
					"id": "c01_close_011",
					"speaker": "Kit",
					"text": "Can you wipe it?"
				},
				{
					"id": "c01_close_012",
					"speaker": "Dee",
					"text": "Let's see where they go first.",
					"gap": 0.8,
					"set": [
						"seen_nine_pins"
					]
				}
			]
		}
