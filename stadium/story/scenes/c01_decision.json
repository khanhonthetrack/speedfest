			"lines": [
				{
					"id": "c01_decision_013",
					"speaker": "Voss",
					"text": "Gus Pell doesn't keep files. Gus Pell sells them.",
					"if": "way:c01=3"
				},
				{
					"id": "c01_decision_014",
					"speaker": "Kit",
					"text": "Then I'm giving you one.",
					"if": "way:c01=3"
				},
				{
					"id": "c01_decision_015",
					"speaker": "Voss",
					"text": "Where did you get this car?",
					"if": "way:c01=3"
				},
				{
					"id": "c01_decision_016",
					"speaker": "Kit",
					"text": "Here. Tonight. Nine hundred.",
					"if": "way:c01=3"
				},
				{
					"id": "c01_decision_017",
					"speaker": "Voss",
					"text": "Then you've had it about four hours too long. Drive carefully, student. Especially on bridges.",
					"if": "way:c01=3"
				}
