			"lines": [
				{
					"id": "c01_decision_001",
					"speaker": "Kit",
					"text": "Arch Nine. Under the railway viaduct. Dee Sandoval. She rebuilds things.",
					"if": "way:c01=0"
				},
				{
					"id": "c01_decision_002",
					"speaker": "Gus",
					"text": "That's worth something to the right people.",
					"if": "way:c01=0"
				},
				{
					"id": "c01_decision_003",
					"speaker": "Kit",
					"text": "She's my friend.",
					"if": "way:c01=0"
				},
				{
					"id": "c01_decision_004",
					"speaker": "Gus",
					"text": "Then you shouldn't have said her name.",
					"if": "way:c01=0"
				},
				{
					"id": "c01_decision_005",
					"speaker": "Kit",
					"text": "Here. That's the rest of my rent. Tell your man it's sold.",
					"if": "way:c01=1"
				},
				{
					"id": "c01_decision_006",
					"speaker": "Gus",
					"text": "Noodles for a month, kid.",
					"if": "way:c01=1"
				},
				{
					"id": "c01_decision_007",
					"speaker": "Kit",
					"text": "I deliver noodles. I'll eat the mistakes.",
					"if": "way:c01=1"
				},
				{
					"id": "c01_decision_008",
					"speaker": "Gus",
					"text": "Fair. And the file's yours. I never had it.",
					"if": "way:c01=1"
				},
				{
					"id": "c01_decision_009",
					"speaker": "Gus",
					"text": "He'll check the number, you know. These people check everything.",
					"if": "way:c01=2"
				},
				{
					"id": "c01_decision_010",
					"speaker": "Kit",
					"text": "Then read him the wrong one slowly.",
					"if": "way:c01=2"
				},
				{
					"id": "c01_decision_011",
					"speaker": "Gus",
					"text": "Four... seven... nine... You're a bad influence, student.",
					"if": "way:c01=2"
				},
				{
					"id": "c01_decision_012",
					"speaker": "Gus",
					"text": "There's a cop at the gate. Been there since you drove in.",
					"if": "way:c01=3"
				}
			],
